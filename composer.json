{
    "name": "jweiland/pforum",
    "type": "typo3-cms-extension",
    "description": "Lightweight forum extension for TYPO3",
    "license": [
        "GPL-2.0-or-later"
    ],
    "keywords": [
        "TYPO3",
        "TYPO3 CMS",
        "forum",
        "pforum",
        "lightweight"
    ],
    "homepage": "https://jweiland.net",
    "authors": [
        {
            "name": "Stefan Froemken",
            "email": "sfroemken@jweiland.net",
            "role": "Developer"
        },
        {
            "name": "Rico Sonntag",
            "email": "rico.sonntag@netresearch.de",
            "role": "Developer",
            "homepage": "https://www.netresearch.de/"
        }
    ],
    "support": {
        "email": "support@jweiland.net",
        "issues": "https://github.com/jweiland-net/pforum/issues",
        "source": "https://github.com/jweiland-net/pforum"
    },
    "config": {
        "bin-dir": ".build/bin",
        "vendor-dir": ".build/vendor",
        "discard-changes": true,
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "a9f/fractor-extension-installer": true,
            "phpro/grumphp": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "platform-check": false
    },
    "require": {
        "php": ">=8.0 <8.4",
        "typo3/cms-core": "^13.4",
        "typo3/cms-backend": "^13.4",
        "typo3/cms-extbase": "^13.4"
    },
    "require-dev": {
        "typo3/testing-framework": "*",
        "friendsofphp/php-cs-fixer": "*",
        "overtrue/phplint": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-phpunit": "*",
        "phpstan/phpstan-strict-rules": "*",
        "phpstan/phpstan-deprecation-rules": "*",
        "ssch/typo3-rector": "*",
        "a9f/typo3-fractor": "*"
    },
    "suggest": {
        "jweiland/checkfaluploads": "Displays a checkbox that must be checked to upload files in backend"
    },
    "autoload": {
        "psr-4": {
            "JWeiland\\Pforum\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JWeiland\\Pforum\\Tests\\": "Tests"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "pforum",
            "web-dir": ".build/public"
        },
        "branch-alias": {
            "dev-main": "5.0.x-dev"
        }
    },
    "scripts": {
        "ci:test:php:functional": "phpunit -c Build/FunctionalTests.xml",
        "ci:test:php:lint": "phplint --configuration Build/.phplint.yml",
        "ci:test:php:unit": "XDEBUG_MODE=coverage && phpunit -c Build/UnitTests.xml",
        "ci:test:php:phpstan": "phpstan analyze --configuration Build/phpstan.neon",
        "ci:test:php:phpstan:baseline": "composer ci:test:php:phpstan --generate-baseline Build/phpstan-baseline.neon --allow-empty-baseline",
        "ci:test:php:rector": "composer php:rector -- --dry-run",
        "ci:test:php:cgl": "composer php:cgl -- --dry-run",
        "ci:test": [
            "@ci:test:php:lint",
            "@ci:test:php:unit",
            "@ci:test:php:phpstan",
            "@ci:test:php:rector",
            "@ci:test:php:cgl"
        ],
        "php:upgrade": [
            "@php:cgl",
            "@php:rector",
            "@php:fractor",
            "@php:cgl"
        ],
        "php:cgl": "php-cs-fixer fix --config Build/.php-cs-fixer.dist.php --diff --verbose --cache-file .build/.php-cs-fixer.cache",
        "php:rector": "rector process --config Build/rector.php",
        "php:fractor": "fractor process"
    }
}
